4.//Chef and stocks
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T > 0) {
            int N = sc.nextInt();
            int t = 0;
            int m = Integer.MAX_VALUE;
            for (int i = 0; i < N; i++) {
                int x = sc.nextInt();
                t += x;
                m = Math.min(m, x);
            }
            System.out.println(t - m);
            T--;
        }
    }
}

