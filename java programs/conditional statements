9.//de composition of three digit number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        n = Math.abs(n);  
        System.out.println(n / 100);
        System.out.println((n / 10) % 10);
        System.out.println(n % 10);
    }
}

