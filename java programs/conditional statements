3.// small,large,or equal
import java.util.Scanner;
class Main{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int a=sc.nextInt();
	    int b=sc.nextInt();
	    if (a < b){
	        System.out.println("a < b");
	    }
	    else if (a > b){
	        System.out.println("a > b");
	    }
	    else{
	        System.out.println("a==b");
	    }
		
	}
}

