4.//counting pretty numbers
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T > 0) {
            int L = sc.nextInt();
            int R = sc.nextInt();
            int count = 0;
            for (int i = L; i <= R; i++) {
                int lastDigit = i % 10;
                if (lastDigit == 2 || lastDigit == 3 || lastDigit == 9) {
                    count++;
                }
            }
            System.out.println(count);
            T--;
        }
    }
}

5.//Multiply the array
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T>0) {
            int N = sc.nextInt();
            long product = 1;   
            for (int i = 0; i < N; i++) {
                int value = sc.nextInt();
                product *= value;
            }
            System.out.println(product);
            T--;
        }
    }
}

6.//solve the case
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T > 0) {
            int n = sc.nextInt();
            int[] arr = new int[n];
            for (int i = 0; i < n; i++) {
                arr[i] = sc.nextInt();
            }
            System.out.print(arr[0]);
            for (int i = 1; i < n; i++) {
                if (arr[i] != arr[i - 1]) {
                    System.out.print(" " + arr[i]);
                }
            }
            System.out.println(); 
            T--;
        }
    }
}

