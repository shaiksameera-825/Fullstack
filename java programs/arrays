2.//Min array
import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int n = sc.nextInt();
        int[] a = new int[n];
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }
        int minValue = a[0];
        int minIndex = 0;
        for (int i = 1; i < n; i++) {
            if (a[i] < minValue) {
                minValue = a[i];
                minIndex = i;
            }
        }
        System.out.println(minIndex);
    }
}

