// Main class to demonstrate interface usage
public class SmartDeviceDemo {
    public static void main(String[] args) {
        RemoteControl device;

        // TV
        System.out.println("=== TV Control ===");
        device = new TV();
        device.powerOn();
        device.increaseVolume();
        device.decreaseVolume();
        device.powerOff();

        // AC
        System.out.println("=== AC Control ===");
        device = new AC();
        device.powerOn();
        device.increaseVolume();
        device.decreaseVolume();
        device.powerOff();

        // Speaker
        System.out.println("=== Speaker Control ===");
        device = new Speaker();
        device.powerOn();
        device.increaseVolume();
        device.decreaseVolume();
        device.powerOff();
    }
}